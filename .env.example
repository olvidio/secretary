APP_NAME=Secretario
APP_USER=scl
APP_PASSWORD=cambiar
APP_DEBUG=1

# Clave de cifrado de secretos TOTP (32+ caracteres aleatorios). Distinta en cada entorno.
APP_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

# Postgres del stack /home/dani/docker_images/secretary (puerto host 5455).
DB_DRIVER=pgsql
DATABASE_DSN=pgsql:host=127.0.0.1;port=5455;dbname=secretario
DB_USER=secretario
DB_PASSWORD=secretario

# Directorio de volcados PostgreSQL (por defecto var/backups dentro del proyecto).
# BACKUP_DIR=/ruta/escribible/copias
# Cliente PostgreSQL (misma major que el servidor; en Docker: postgresql-client-15).
# PG_DUMP=/usr/lib/postgresql/15/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/15/bin/pg_restore

# PostgreSQL es el único motor soportado (D9, docs/dev/plan_ampliaciones.md).
# DB_DRIVER solo admite 'pgsql'; cualquier otro valor falla explícitamente.

# Ventana de ayuda (docs/dev/ayuda_ia.md). Por defecto: Gemini 3.5 Flash-Lite
# (nivel gratuito de AI Studio). URL y modelo ya van en el código; solo hace
# falta la clave: https://aistudio.google.com/apikey
# Sin clave la pantalla sigue: responde con los apartados del manual, sin IA.
# Google puede entrenar con el tráfico gratuito. En un servidor público, clave de pago.
AYUDA_IA_CLAVE=
# AYUDA_IA_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AYUDA_IA_MODELO=gemini-3.5-flash-lite
# AYUDA_IA_TIMEOUT=25
# AYUDA_IA_LIMITE_DIARIO=30
