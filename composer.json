{
  "name": "secretary/secretary",
  "description": "Programa Secretario: contabilidad P/G de un centro",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-bcmath": "*",
    "ext-zip": "*",
    "ext-simplexml": "*",
    "ext-openssl": "*",
    "php-di/php-di": "^7.1",
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "src\\": "src/",
      "frontend\\": "frontend/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php vendor/bin/phpunit --configuration phpunit.xml",
    "phpstan": "php vendor/bin/phpstan analyse --memory-limit=1G",
    "db:migrate": "php bin/console.php db:migrate",
    "db:status": "php bin/console.php db:status",
    "db:install": "php bin/console.php db:install",
    "import": "php bin/console.php import:excel",
    "serve": "php -S 127.0.0.1:8088 -t public public/router.php"
  },
  "config": {
    "platform": {
      "php": "8.2"
    }
  }
}
